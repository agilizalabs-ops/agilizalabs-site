{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "agilizalabs-site",
	// Entrada própria: o Astro atende as páginas e src/worker.ts acrescenta as rotinas agendadas do chat.
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"workers_dev": true,
	"routes": [
		{ "pattern": "agilizalabs.com.br", "custom_domain": true },
		{ "pattern": "www.agilizalabs.com.br", "custom_domain": true }
	],
	// Assistente com IA. Troque modelo e esforço aqui, sem mexer no código.
	"vars": {
		"IA_MODELO": "claude-haiku-5-5",
		"IA_ESFORCO": "xhigh",
		"AVISOS_DE": "avisos@agilizalabs.com.br",
		"AVISOS_PARA": "agilizalabs@gmail.com",
		// Agenda do Google onde caem as conversas marcadas pelo site (compartilhada com a conta de serviço).
		"AGENDA_ID": "agilizalabs@gmail.com"
	},
	"d1_databases": [
		{ "binding": "DB", "database_name": "agilizalabs-chat", "database_id": "2ce486e6-061c-4f78-81b2-16a14bcbb44f", "migrations_dir": "migrations" }
	],
	// Avisos de contato novo e resumo semanal, para o Gmail que já recebe o contato@.
	"send_email": [{ "name": "AVISOS", "destination_address": "agilizalabs@gmail.com" }],
	// Proteção de custo: cada IP pode mandar até 20 mensagens por minuto.
	"ratelimits": [{ "name": "LIMITE_CHAT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
	"triggers": {
		// 06:00 UTC todo dia: apaga o que expirou. 11:00 UTC na segunda (08:00 em Brasília): resumo da semana.
		"crons": ["0 6 * * *", "0 11 * * 1"]
	},
	"observability": {
		"enabled": true
	}
}

{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "agilizalabs-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"workers_dev": true,
	"routes": [
		{ "pattern": "agilizalabs.com.br", "custom_domain": true },
		{ "pattern": "www.agilizalabs.com.br", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	}
}
---
// Agiliza Express: página de venda direta para quem chega pelo anúncio do Instagram.
// Preços em src/data/tiers.ts (express); vagas contadas no banco (pedidos pagos na semana).
// Decisões em 01 Empresa/agiliza-express.md, no vault.
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { tiers, express, brl, brlCentavos } from '../../data/tiers';
import ExpressProximosPassos from '../../components/ExpressProximosPassos.astro';
import { vagasRestantes } from '../../lib/express';
import { linkWhatsApp } from '../../config';

export const prerender = false;

let restantes: number = express.vagasPorSemana;
try {
  restantes = await vagasRestantes(env.DB);
} catch (erro) {
  console.error('Não deu para contar as vagas do Express.', erro);
}
const lotado = restantes === 0;
const preenchidas = express.vagasPorSemana - restantes;

// Padrão útil: já deixa marcada a cidade de onde a pessoa acessa, quando é uma das atendidas (o Cloudflare sabe pela conexão).
const semAcento = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const cidadeDaConexao = (Astro.request as Request & { cf?: { city?: string } }).cf?.city;
const cidadeDetectada = express.cidades.find((c) => cidadeDaConexao && semAcento(c) === semAcento(cidadeDaConexao));

const presenca = tiers.find((t) => t.id === 'presenca')!.formas.find((f) => f.nome === 'Com Cuidado')!;
const institucional = tiers.find((t) => t.id === 'institucional')!.formas.find((f) => f.nome === 'Com Cuidado')!;
// Enquadramento só quando é verdade: o valor por dia sai do preço de tiers.ts.
const porDia = express.mensal / 30 < 1 ? 'menos de R$ 1 por dia' : `cerca de ${brlCentavos(Math.ceil((express.mensal / 30) * 10) / 10)} por dia`;
const cidadesTexto = express.cidades.join(', ').replace(/, ([^,]*)$/, ' e $1');

const menu = [
  { href: '#como-funciona', texto: 'Como funciona' },
  { href: '#modelos', texto: 'Modelos' },
  { href: '#planos', texto: 'Planos' },
  { href: '#duvidas', texto: 'Dúvidas' },
];

const duvidas = [
  { p: 'Por que tão barato? Tem pegadinha?', r: 'O site sai de um modelo pronto, feito para o seu ramo. Você economiza no sob medida, não na qualidade: o site é rápido, preparado para o Google e o domínio fica no seu nome. O que está nesta página é o que você recebe.' },
  { p: 'O que acontece depois que eu pago?', r: `Na mesma hora abre uma tela para você montar o site: fotos, serviços, preços, horário e o endereço do site. Leva uns 5 minutos e salva sozinho. Quando você envia, o prazo de ${express.prazoHorasUteis} horas úteis começa a contar.` },
  { p: 'E se eu não gostar do resultado?', r: 'Você vê o site pronto no celular antes de ir ao ar e pede 1 rodada de ajustes. Ele só é publicado depois do seu OK.' },
  { p: 'Posso desistir depois de pagar?', r: 'Pode. Em até 7 dias depois do pagamento, você desiste e recebe o valor de volta, sem precisar explicar.' },
  { p: 'Quero mudar um preço depois. Como faço?', r: 'Cada alteração pequena custa R$ 80. Se você muda muito, o Agenda Cheia sai mais em conta: tem 1 alteração por mês inclusa.' },
  { p: 'Posso cancelar a mensalidade?', r: `A fidelidade é de ${express.fidelidadeMeses} meses. Depois disso, é só avisar com 30 dias de antecedência, e o domínio continua no seu nome. Os detalhes estão nos termos.` },
  { p: 'Atende a minha cidade?', r: `O Express atende ${cidadesTexto}.` },
];

const dadosEstruturados = {
  '@context': 'https://schema.org',
  '@type': 'Offer',
  name: 'Agiliza Express: site profissional no ar em 48 horas',
  price: express.setup.toFixed(2),
  priceCurrency: 'BRL',
  url: 'https://agilizalabs.com.br/express',
  seller: { '@type': 'Organization', name: 'Agiliza Labs' },
  areaServed: express.cidades.map((c) => ({ '@type': 'City', name: c })),
};
---

<Layout
  title={`Site profissional por ${brl(express.setup)} | Agiliza Express`}
  description={`Seu site no ar em 48 horas por ${brl(express.setup)} + ${brlCentavos(express.mensal)}/mês, com domínio .com.br no seu nome. Para negócios de ${cidadesTexto}.`}
  menu={menu}
  semAssistente
>
  <script type="application/ld+json" set:html={JSON.stringify(dadosEstruturados)} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;1,6..96,500&family=DM+Sans:opsz,wght@9..40,400;9..40,700&display=swap" />
  <div class="xp">
    <section class="hero"><div class="conteudo grade-hero">
      <div class="texto">
        <div class="vagas-mini"><i class="ponto"></i><span>{lotado ? 'Vagas desta semana esgotadas' : `Restam ${restantes} de ${express.vagasPorSemana} vagas nesta semana`}</span></div>
        <p class="eyebrow">{express.cidades.join(' · ')}</p>
        <h1>Seu negócio com <mark>site profissional</mark> no ar em 48 horas.</h1>
        <p class="sub">Você manda as fotos, os serviços e os preços. A gente monta, publica e mantém o site no ar. Sem reunião e sem enrolação.</p>
        <div class="preco">
          <div class="grande"><span>R$</span>{express.setup}</div>
          <div class="mensal">+ <b>{brlCentavos(express.mensal)}/mês</b> de hospedagem ({porDia})<br />1ª mensalidade só 1 mês depois do site no ar</div>
        </div>
        <div class="acoes">
          <a class="btn btn-lima" href="#checkout">Quero meu site por {brl(express.setup)}</a>
          <a class="btn btn-borda" href="/express/exemplo">Ver um site pronto</a>
        </div>
        <div class="selos"><span>Domínio .com.br no seu nome</span><span>Feito para celular</span><span>Botão direto pro seu WhatsApp</span></div>
      </div>

      <a class="celular" href="/express/exemplo" aria-label="Abrir o site de exemplo de uma manicure">
        <div class="tela">
          <div class="mini-top"><span><i>Íris</i> Unhas</span><small>Agendar</small></div>
          <div class="mini-foto"></div>
          <div class="mini-txt">Unhas impecáveis por três semanas.</div>
          <div class="mini-btn">Agendar pelo WhatsApp</div>
          <div class="mini-lista">
            <div><span>Esmaltação em gel</span><b>R$ 70</b></div>
            <div><span>Pé e mão</span><b>R$ 60</b></div>
          </div>
        </div>
        <span class="etiqueta">Um site Express fica assim →</span>
      </a>
    </div></section>

    <section class="bloco"><div class="conteudo pilha">
      <div class="titulo">
        <p class="eyebrow">O que vem no Express</p>
        <h2>Tudo que um site precisa para trazer cliente. Nada que você não vá usar.</h2>
      </div>
      <div class="inclui">
        <ul class="lista-sim">
          <li class="cab"><h3>Incluso nos {brl(express.setup)}</h3></li>
          <li><div><b>Site de 1 página, montado no modelo do seu ramo</b><span>Serviços, preços, fotos, horário e dúvidas frequentes.</span></div></li>
          <li><div><b>Domínio .com.br registrado no seu nome</b><span>seunegocio.com.br. Se um dia sair, o endereço é seu.</span></div></li>
          <li><div><b>Botão de WhatsApp com mensagem pronta</b><span>A cliente toca e já chega dizendo o que quer.</span></div></li>
          <li><div><b>Preparado para o Google</b><span>Título com serviço e cidade, dados para o Google e as IAs, rápido no celular.</span></div></li>
          <li><div><b>Mapa e como chegar</b><span>Para quem procura um lugar "perto de mim".</span></div></li>
          <li><div><b>1 revisão antes de publicar</b><span>Você vê o site pronto e pede o ajuste antes de ir ao ar.</span></div></li>
        </ul>
        <ul class="lista-nao">
          <li class="cab"><h3>Fica de fora (e tudo bem)</h3></li>
          <li><div><b>Layout sob medida</b><span>O Express usa um modelo pronto do seu ramo. Sob medida é o plano Agenda Cheia.</span></div></li>
          <li><div><b>Google Maps</b><span>Opcional no pagamento, por mais {brl(express.maps)}.</span></div></li>
          <li><div><b>Alterações todo mês</b><span>Mudou um preço? R$ 80 por alteração pequena.</span></div></li>
        </ul>
      </div>
    </div></section>

    <section class="bloco" id="como-funciona"><div class="conteudo pilha">
      <div class="titulo">
        <p class="eyebrow">Como funciona</p>
        <h2>Do pagamento ao site no ar em 4 passos.</h2>
      </div>
      <ol class="passos">
        <li><span class="tempo">Agora</span><b>Você garante a vaga</b><span>Pix ou cartão, aqui mesmo nesta página.</span></li>
        <li><span class="tempo">5 minutos</span><b>Monta o seu site</b><span>Fotos, serviços, preços e horário, numa tela simples logo depois de pagar.</span></li>
        <li><span class="tempo">Até {express.prazoHorasUteis} h úteis</span><b>Recebe o site pronto</b><span>Você olha no celular e pede 1 ajuste se quiser.</span></li>
        <li><span class="tempo">Logo depois do OK</span><b>Seu site vai ao ar</b><span>Com o seu domínio .com.br, pronto para divulgar.</span></li>
      </ol>
    </div></section>

    <section class="bloco" id="modelos"><div class="conteudo pilha">
      <div class="titulo">
        <p class="eyebrow">3 modelos</p>
        <h2>Um modelo pensado para o seu ramo, com as suas fotos e as suas cores.</h2>
      </div>
      <div class="modelos">
        <div class="modelo">
          <div class="amostra m-beleza"><div class="t">Unhas impecáveis por três semanas.</div><div class="p"><i style="background:#b8476b"></i><i style="background:#34152a"></i><i style="background:#efd9d0"></i></div></div>
          <div class="info"><b>Beleza e saúde</b><span>Manicure, sobrancelha, estética, cabelo, dentista, psicóloga, fisioterapia.</span><a href="/express/exemplo">Ver site de exemplo →</a></div>
        </div>
        <div class="modelo">
          <div class="amostra m-servicos"><div class="t">Elétrica sem dor de cabeça.</div><div class="p"><i style="background:#f4d35e"></i><i style="background:#1d4a53"></i><i style="background:#ffffff"></i></div></div>
          <div class="info"><b>Serviços e casa</b><span>Eletricista, encanador, pintor, diarista, mecânico, chaveiro, jardinagem.</span><em>Exemplo em breve</em></div>
        </div>
        <div class="modelo">
          <div class="amostra m-comida"><div class="t">O xis mais pedido do bairro.</div><div class="p"><i style="background:#e4572e"></i><i style="background:#3a1a0e"></i><i style="background:#fff3df"></i></div></div>
          <div class="info"><b>Comércio e comida</b><span>Lanchonete, padaria, confeitaria, loja de roupa, pet shop, floricultura.</span><em>Exemplo em breve</em></div>
        </div>
      </div>
    </div></section>

    <section class="bloco" id="planos"><div class="conteudo pilha">
      <div class="titulo">
        <p class="eyebrow">Planos da Agiliza</p>
        <h2>Comece pelo Express. Suba quando o negócio pedir.</h2>
        <p>Setup + mensalidade. O Express é a porta de entrada, com o mesmo cuidado dos planos maiores.</p>
      </div>
      <div class="escada">
        <div class="degrau voce">
          <span class="tag">Você está aqui</span>
          <h3>Express</h3>
          <div class="v">{brl(express.setup)}<small>+ {brlCentavos(express.mensal)}/mês</small></div>
          <p>1 página em modelo pronto, no ar em 48 h.</p>
        </div>
        <a class="degrau" href="/#tipo-presenca">
          <span class="tag">Autônomos</span>
          <h3>Agenda Cheia</h3>
          <div class="v">{brl(presenca.setup)}<small>+ {brl(presenca.mensal!)}/mês</small></div>
          <p>Layout sob medida, Google Maps, atendente com IA e 1 alteração por mês.</p>
        </a>
        <a class="degrau" href="/#tipo-institucional">
          <span class="tag">Empresas</span>
          <h3>Institucional</h3>
          <div class="v">{brl(institucional.setup)}<small>+ {brl(institucional.mensal!)}/mês</small></div>
          <p>Até 5 páginas, formulário de orçamento e 3 alterações por mês.</p>
        </a>
        <div class="degrau">
          <span class="tag">Sistemas e apps</span>
          <h3>Sob Medida</h3>
          <div class="v">R$ 6.000<small>a partir de</small></div>
          <p>App ou sistema web com diagnóstico e protótipo antes de começar.</p>
        </div>
      </div>
      <div class="credito"><strong>Seus {brl(express.setup)} voltam</strong><span>Subiu para o Agenda Cheia em até {express.creditoDias} dias? O valor do Express vira desconto no setup.</span></div>
    </div></section>

    <section class="bloco" id="checkout"><div class="conteudo grade-checkout">
      <div class="lado">
        <div class="titulo">
          <p class="eyebrow">Garanta sua vaga</p>
          <h2>Montamos {express.vagasPorSemana} sites Express por semana.</h2>
          <p>É o número que dá para entregar em 48 horas com qualidade. Quando lota, as próximas vagas abrem na segunda-feira.</p>
        </div>
        <div class="medidor">
          <div class="barra" role="progressbar" aria-valuemin="0" aria-valuemax={express.vagasPorSemana} aria-valuenow={preenchidas} aria-label="Vagas preenchidas nesta semana"><i style={`width:${Math.max(4, (preenchidas / express.vagasPorSemana) * 100)}%`}></i></div>
          <span><b>{preenchidas} de {express.vagasPorSemana}</b> vagas preenchidas nesta semana</span>
        </div>
        <p class="autoridade">Quem faz é a Agiliza Labs, de São Bento do Sul, a mesma equipe do site e do app da <a href="https://novafmsbs.com.br" target="_blank" rel="noopener">Nova FM 87,5</a>.</p>
      </div>

      <form class="pedido" id="pedido" novalidate autocomplete="on" data-setup={express.setup} data-maps={express.maps} data-zap-link={linkWhatsApp('Oi! Paguei o Agiliza Express e preciso do link para montar o meu site.')}>
        <ol class="etapas" aria-label="Etapas da compra">
          <li aria-current="step">1. Seus dados</li>
          <li>2. Pagamento</li>
          <li>3. Fotos e informações</li>
        </ol>
        <div class="campos">
          <div class="campo largo"><label for="negocio">Nome do negócio</label><input id="negocio" name="negocio" type="text" required minlength="2" maxlength="80" placeholder="Ex.: Íris Unhas" autocomplete="organization" enterkeyhint="next" /></div>
          <div class="campo"><label for="whatsapp">WhatsApp com DDD</label><input id="whatsapp" name="whatsapp" type="tel" required inputmode="tel" placeholder="(47) 99999-9999" autocomplete="tel" enterkeyhint="next" /></div>
          <div class="campo"><label for="cidade">Cidade</label>
            <select id="cidade" name="cidade" autocomplete="address-level2">{express.cidades.map((c) => <option selected={c === cidadeDetectada}>{c}</option>)}</select></div>
          <div class="campo largo"><label for="email">E-mail <small>(para o comprovante)</small></label><input id="email" name="email" type="email" required inputmode="email" autocapitalize="off" spellcheck="false" placeholder="voce@gmail.com" autocomplete="email" enterkeyhint="done" /></div>
        </div>
        <p class="dica">Se sair e voltar, o que você digitou continua aqui (fica só neste aparelho).</p>

        <label class="bump" for="maps">
          <input type="checkbox" id="maps" name="maps" />
          <div><b>Quero aparecer no Google Maps por + {brl(express.maps)}</b><span>Crio ou ajusto o seu Perfil da Empresa no Google: categoria, fotos, horário e link do site. Avulso custa <s>{brl(express.mapsAvulso)}</s>.</span></div>
        </label>

        <div class="resumo">
          <div class="linha"><span>Site Express (setup)</span><span>{brlCentavos(express.setup)}</span></div>
          <div class="linha" id="linha-maps" hidden><span>Google Maps</span><span>{brlCentavos(express.maps)}</span></div>
          <div class="total"><span>Total hoje</span><b id="total">{brlCentavos(express.setup)}</b></div>
          <p class="depois">Depois: {brlCentavos(express.mensal)}/mês ({porDia}), a 1ª só 1 mês depois do site no ar, com fidelidade de {express.fidelidadeMeses} meses.</p>
        </div>

        <label class="aceite" for="aceite">
          <input type="checkbox" id="aceite" name="aceite" required />
          <span>Li e aceito os <a href="/express/termos" target="_blank">termos do Express</a>: mensalidade de {brlCentavos(express.mensal)} com fidelidade de {express.fidelidadeMeses} meses, a 1ª cobrança 1 mês depois do site no ar.</span>
        </label>
        <button class="btn btn-lima" id="pagar" type="submit" disabled={lotado}>{lotado ? 'Vagas da semana esgotadas' : `Pagar ${brlCentavos(express.setup)} com Pix ou cartão`}</button>
        <p class="retorno" id="retorno" role="alert" hidden></p>
        <p class="garantia">🔒 Pagamento pela InfinitePay, numa janela por cima desta página. A Agiliza não vê os dados do seu cartão. Você tem 7 dias para desistir, com devolução total.</p>
      </form>
    </div></section>

    <section class="bloco" id="duvidas"><div class="conteudo pilha">
      <div class="titulo"><p class="eyebrow">Dúvidas</p><h2>Antes de garantir a vaga</h2></div>
      <div class="faq">
        {duvidas.map((d) => <details><summary>{d.p}</summary><p>{d.r}</p></details>)}
      </div>
    </div></section>

    <section class="bloco"><div class="conteudo final">
      <h2>Quem procura o seu serviço na cidade acha quem tem site.</h2>
      <p>Em até 48 horas úteis depois das suas fotos, o seu negócio aparece com um site seu, com domínio no seu nome.</p>
      <a class="btn btn-lima" href="#checkout">Quero meu site por {brl(express.setup)}</a>
      <span>+ {brlCentavos(express.mensal)}/mês · 7 dias para desistir</span>
    </div></section>

    <dialog class="janela-pagamento" id="dialogo" aria-labelledby="dialogo-titulo">
      <div id="esperando">
        <ol class="etapas" aria-label="Etapas da compra">
          <li>✓ Seus dados</li>
          <li aria-current="step">2. Pagamento</li>
          <li>3. Fotos e informações</li>
        </ol>
        <h2 id="dialogo-titulo">Conclua o pagamento na janela da InfinitePay</h2>
        <p class="mudo">Pix ou cartão. Assim que o pagamento cair, esta tela muda sozinha.</p>
        <p class="aguardando" role="status" aria-live="polite"><i class="girando" aria-hidden="true"></i><span id="status-texto">Aguardando o pagamento…</span></p>
        <div class="acoes-dialogo">
          <button class="btn btn-lima" type="button" id="reabrir">Abrir o pagamento de novo</button>
          <button class="btn btn-borda" type="button" id="voltar">Voltar e corrigir os dados</button>
        </div>
      </div>
      <div id="pago" hidden>
        <ExpressProximosPassos negocio="seu negócio" linkEnvio="#" />
      </div>
    </dialog>

    <div class="fixo" id="fixo"><div class="conteudo">
      <div class="r">Site Express<b>{brl(express.setup)} + {brlCentavos(express.mensal)}/mês</b></div>
      <a class="btn btn-lima" href="#checkout">Quero o meu</a>
    </div></div>
  </div>
</Layout>

<script>
  const form = document.getElementById('pedido') as HTMLFormElement;
  const campo = (nome: string) => form.elements.namedItem(nome) as HTMLInputElement;
  const maps = campo('maps');
  const aceite = campo('aceite');
  const whatsapp = campo('whatsapp');
  const email = campo('email');
  const negocio = campo('negocio');
  const total = document.getElementById('total')!;
  const linhaMaps = document.getElementById('linha-maps')!;
  const pagar = document.getElementById('pagar') as HTMLButtonElement;
  const retorno = document.getElementById('retorno')!;
  const dialogo = document.getElementById('dialogo') as HTMLDialogElement;
  const statusTexto = document.getElementById('status-texto')!;
  const lotado = pagar.disabled;
  const setup = Number(form.dataset.setup);
  const valorMaps = Number(form.dataset.maps);
  const brl = (v: number) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const valor = () => setup + (maps.checked ? valorMaps : 0);

  function atualizar() {
    linhaMaps.hidden = !maps.checked;
    total.textContent = brl(valor());
    if (!lotado) pagar.textContent = `Pagar ${brl(valor())} com Pix ou cartão`;
  }

  // Preenchimento automático: o navegador completa pelos autocomplete; o que a pessoa digitou fica salvo
  // neste aparelho para quando ela voltar do Instagram. Só conveniência: sem o storage, a página funciona igual.
  const CHAVE = 'agiliza-express-dados';
  const salvos = ['negocio', 'whatsapp', 'email', 'cidade'];
  try {
    const dados = JSON.parse(localStorage.getItem(CHAVE) ?? '{}') as Record<string, string>;
    for (const nome of salvos) if (dados[nome]) campo(nome).value = dados[nome];
  } catch {}
  function salvar() {
    try {
      localStorage.setItem(CHAVE, JSON.stringify(Object.fromEntries(salvos.map((n) => [n, campo(n).value]))));
    } catch {}
  }
  form.addEventListener('input', salvar);
  form.addEventListener('change', salvar);

  // WhatsApp no formato (47) 99999-9999, aceitando o +55 que o preenchimento automático costuma trazer.
  function mascara(texto: string) {
    let d = texto.replace(/\D/g, '');
    if (d.length > 11 && d.startsWith('55')) d = d.slice(2);
    d = d.slice(0, 11);
    if (d.length <= 2) return d ? `(${d}` : '';
    if (d.length <= 6) return `(${d.slice(0, 2)}) ${d.slice(2)}`;
    if (d.length <= 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;
    return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;
  }
  whatsapp.value = mascara(whatsapp.value);
  whatsapp.addEventListener('input', () => (whatsapp.value = mascara(whatsapp.value)));
  email.addEventListener('blur', () => (email.value = email.value.trim().toLowerCase()));

  // Mensagens de erro em português, campo a campo.
  function validar() {
    const digitos = whatsapp.value.replace(/\D/g, '');
    negocio.setCustomValidity(negocio.value.trim().length >= 2 ? '' : 'Coloque o nome do seu negócio.');
    whatsapp.setCustomValidity(digitos.length === 10 || digitos.length === 11 ? '' : 'Coloque o WhatsApp com DDD, por exemplo (47) 99999-9999.');
    email.setCustomValidity(/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim()) ? '' : 'Confira o e-mail, por exemplo voce@gmail.com.');
    aceite.setCustomValidity(aceite.checked ? '' : 'Marque que leu e aceita os termos para continuar.');
    return form.reportValidity();
  }
  for (const c of [negocio, whatsapp, email, aceite]) c.addEventListener('input', () => c.setCustomValidity(''));
  maps.addEventListener('change', atualizar);
  atualizar();

  function avisar(texto: string) {
    retorno.textContent = texto;
    retorno.hidden = false;
  }

  // Pagamento: a InfinitePay não deixa embutir o checkout, então ele abre numa janela por cima desta página.
  // Esta página espera: confirma pela mensagem da página de retorno e, de garantia, pergunta ao servidor (webhook).
  let pedido = '';
  let urlPagamento = '';
  let janela: Window | null = null;
  let vigia: ReturnType<typeof setInterval> | undefined;

  function abrirJanela(url = '') {
    janela = window.open(url, 'infinitepay', 'popup,width=480,height=760');
    return janela;
  }

  function mostrarPago(dados: { negocio?: string; linkEnvio?: string }) {
    clearInterval(vigia);
    janela?.close();
    document.getElementById('esperando')!.hidden = true;
    const pago = document.getElementById('pago')!;
    pago.hidden = false;
    if (dados.negocio) pago.querySelector('[data-negocio]')!.textContent = dados.negocio;
    const botao = pago.querySelector<HTMLAnchorElement>('[data-link-envio]')!;
    if (dados.linkEnvio) botao.href = dados.linkEnvio;
    else {
      // Cookie de outro pedido (pagou de novo depois de "Voltar"): o link não sai aqui, então pede pelo WhatsApp.
      botao.href = form.dataset.zapLink!;
      botao.textContent = 'Pedir o link para montar o site';
    }
    if (!dialogo.open) dialogo.showModal();
    try {
      localStorage.removeItem(CHAVE);
    } catch {}
  }

  async function conferir() {
    if (!pedido) return;
    try {
      const r = await fetch(`/api/express-status?pedido=${encodeURIComponent(pedido)}`);
      const dados = await r.json();
      if (dados.pago) return mostrarPago(dados);
    } catch {}
    if (janela?.closed) statusTexto.textContent = 'A janela de pagamento foi fechada. Se já pagou, aguarde uns segundos; se não, abra de novo.';
  }

  window.addEventListener('message', (e) => {
    if (e.origin !== location.origin || e.data?.tipo !== 'express' || e.data.pedido !== pedido) return;
    if (e.data.pago) conferir();
  });

  function esperar() {
    statusTexto.textContent = `Aguardando o pagamento de ${brl(valor())}…`;
    dialogo.showModal();
    clearInterval(vigia);
    vigia = setInterval(conferir, 4000);
  }

  document.getElementById('reabrir')!.addEventListener('click', () => {
    if (!abrirJanela(urlPagamento)) location.href = urlPagamento;
    statusTexto.textContent = `Pagamento aberto de novo. Aguardando ${brl(valor())}…`;
  });
  document.getElementById('voltar')!.addEventListener('click', () => {
    clearInterval(vigia);
    janela?.close();
    dialogo.close();
  });
  dialogo.addEventListener('close', () => clearInterval(vigia));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    retorno.hidden = true;
    if (lotado || !validar()) return;
    // A janela abre já no clique; abrir depois do fetch faz o navegador bloquear.
    abrirJanela();
    pagar.disabled = true;
    pagar.textContent = 'Abrindo o pagamento…';
    try {
      const resposta = await fetch('/api/express-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          negocio: negocio.value,
          cidade: campo('cidade').value,
          whatsapp: whatsapp.value,
          email: email.value,
          maps: maps.checked,
          aceite: aceite.checked,
        }),
      });
      const dados = await resposta.json();
      if (!resposta.ok || !dados.url) throw new Error(dados.erro);
      pedido = dados.pedido;
      urlPagamento = dados.url;
      if (!janela || janela.closed) {
        location.href = urlPagamento; // janela bloqueada: segue na mesma aba e volta pela página de retorno
        return;
      }
      janela.location.href = urlPagamento;
      esperar();
    } catch (erro) {
      janela?.close();
      avisar(erro instanceof Error && erro.message ? erro.message : 'Algo deu errado. Tente de novo.');
    } finally {
      pagar.disabled = false;
      atualizar();
    }
  });

  // A barra fixa some quando o checkout está na tela.
  const fixo = document.getElementById('fixo')!;
  new IntersectionObserver((es) => fixo.classList.toggle('some', es[0].isIntersecting), { threshold: 0.15 }).observe(document.getElementById('checkout')!);
</script>


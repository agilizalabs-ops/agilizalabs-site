---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import ExpressProximosPassos from '../../components/ExpressProximosPassos.astro';
import { confirmarPagamento, mensagemExpress, linkEnvio, mesmoNavegador } from '../../lib/express';
import { linkWhatsApp } from '../../config';

export const prerender = false;

// A InfinitePay volta para cá. Normalmente esta página abre na janela do pagamento, avisa a /express e fecha;
// se o navegador bloqueou a janela, ela é o fim da compra na mesma aba.
const parametros = Astro.url.searchParams;
const id = parametros.get('order_nsu') ?? '';
let resultado: Awaited<ReturnType<typeof confirmarPagamento>> = { pedido: null, pago: false };
try {
  resultado = await confirmarPagamento(env, id, parametros.get('transaction_nsu'), parametros.get('slug'));
} catch (erro) {
  console.error(erro);
}
const { pedido, pago } = resultado;
// O link de envio só aparece no navegador que fez a compra; nos outros, a pessoa recebe o link pelo Carlos.
const envio = pago && pedido && mesmoNavegador(Astro.request, pedido) ? linkEnvio(pedido.codigo!) : '';
Astro.response.headers.set('X-Robots-Tag', 'noindex');
---

<Layout title="Pagamento do Express | Agiliza Labs" description="Retorno do pagamento do Agiliza Express." semAssistente>
  <section class="conteudo max-w-xl py-16" data-pago={String(pago)} data-pedido={pedido?.id ?? ''}>
    {pago && pedido && envio ? (
      <ExpressProximosPassos negocio={pedido.negocio} linkEnvio={envio} />
    ) : pago && pedido ? (
      <>
        <p class="text-sm font-semibold uppercase tracking-wide text-lima-escura">Pagamento confirmado ✓</p>
        <h1 class="mt-2 text-4xl">Sua vaga está garantida!</h1>
        <p class="mt-4 text-grafite">Por segurança, o link para montar o seu site só abre no aparelho em que você fez o pedido. Se trocou de navegador, a gente te manda o link pelo WhatsApp.</p>
        <a class="botao-principal mt-8" href={linkWhatsApp(mensagemExpress(pedido))}>Pedir o link no WhatsApp</a>
      </>
    ) : (
      <>
        <h1 class="text-4xl">Ainda não confirmamos o pagamento</h1>
        <p class="mt-4 text-grafite">Se você pagou, pode levar alguns instantes. Atualize esta página ou fale com a gente.</p>
        <a class="botao-principal mt-8" href={linkWhatsApp(mensagemExpress(pedido))}>Falar no WhatsApp</a>
      </>
    )}
  </section>
</Layout>

<script>
  // Aberta como janela pela /express: avisa a página de origem e fecha.
  const secao = document.querySelector<HTMLElement>('[data-pago]');
  const pago = secao?.dataset.pago === 'true';
  if (window.opener && !window.opener.closed) {
    window.opener.postMessage({ tipo: 'express', pago, pedido: secao?.dataset.pedido }, location.origin);
    if (pago) setTimeout(() => window.close(), 1200);
  }
</script>

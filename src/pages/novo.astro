---
// MOCKUP v3 (branch mockup-fluxo). Não publicar: preços ainda são proposta.
// Conceito "letreiro": os 4 Tiers abrem a página, em letra grande e com preço.
// Tiers e preços vêm de src/data/tiers.ts.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { site, linkWhatsApp } from '../config';
import { tiers, precoDeVitrine, precoDaForma, fundadores } from '../data/tiers';
import novafmSite from '../assets/projetos/novafm-site.jpg';
import portalSite from '../assets/projetos/portal-site.jpg';
import appAoVivo from '../assets/projetos/aovivo.png';
import appProgramacao from '../assets/projetos/programacao.png';
import appNoticias from '../assets/projetos/noticias.png';
import appPremios from '../assets/projetos/premios.png';

const menu = [
  { href: '#tipos', texto: 'Tipos de site' },
  { href: '#como-funciona', texto: 'Como funciona' },
  { href: '#projetos', texto: 'Projetos' },
  { href: '#duvidas', texto: 'Dúvidas' },
];

const passos = [
  { titulo: 'Conversa de 15 minutos', texto: 'Pessoalmente ou no WhatsApp. Eu anoto o que você faz, quem é o seu cliente e o que te preocupa.' },
  { titulo: 'Entrada de 30% e prazo por escrito', texto: 'Pelo Pix. A produção começa no mesmo dia.' },
  { titulo: 'Você aprova no próprio layout', texto: 'O layout chega num link com dois botões: aprovar ou pedir uma correção.' },
  { titulo: 'Paga o restante e vai ao ar', texto: 'Pix ou cartão, ali mesmo. O site entra no ar em até 1 dia útil.' },
];

const seo = [
  'Google Perfil completo, que é o que mais pesa no "perto de mim"',
  'Nome, endereço e telefone iguais no site, no Google e nas redes',
  'Dados estruturados que o Google e as IAs leem para saber o que você faz e onde',
  'Títulos e páginas com o serviço e a cidade',
  'Perguntas frequentes escritas do jeito que as pessoas pesquisam',
  'Cadastro no Google e no Bing, que alimenta a busca do ChatGPT',
  'Nota mínima de 90 no teste de velocidade do Google, no celular',
];

const robo = [
  { etapa: 'Fonte oficial', texto: 'A prefeitura publica: "Inscrições abertas para o curso de panificação até sexta."' },
  { etapa: 'IA escreve', texto: 'Título, linha fina, texto próprio, categoria e tags no padrão do jornal.' },
  { etapa: 'Auditoria', texto: 'Todo número, nome e citação precisa existir no original. Se não bater, a matéria não segue.' },
  { etapa: 'Redação aprova', texto: 'Chega no painel como "aguardando aprovação". Nada vai ao ar sozinho.' },
];

const duvidas = [
  { p: 'E se eu não gostar do layout?', r: 'Você pede uma correção antes de aprovar, e os 70% só são cobrados depois que você clica em "Aprovar layout".' },
  { p: 'Qual a diferença entre pagar uma vez e ter o Cuidado?', r: 'Pago uma vez, você recebe o site aprovado e fica com ele. Cada alteração depois é cobrada à parte. Com Cuidado, você paga menos no começo, e a mensalidade cobre a hospedagem, o atendente com IA e o meu acompanhamento para o site converter mais. No longo prazo o Cuidado custa mais, e em troca você não precisa pensar no site.' },
  { p: 'O que faz o atendente com IA?', r: 'Ele aprende os seus serviços, preços e horários e responde as dúvidas dos seus clientes a qualquer hora. Vem no plano com Cuidado e custa bem menos do que uma assinatura de IA por conta própria.' },
  { p: 'Vocês garantem primeiro lugar no Google?', r: 'Não. Ninguém controla a posição, e quem promete está chutando. O que eu garanto é o SEO feito do jeito que o Google e as IAs usam para escolher quem mostrar.' },
  { p: 'O domínio fica no meu nome?', r: 'Sim, o endereço .com.br é registrado no seu nome. Se um dia quiser sair, leva tudo.' },
  { p: 'Meu sobrinho faz site. Por que eu pagaria você?', r: 'Ele pode fazer um ótimo site. Comigo vêm junto o SEO, o Google Perfil, o prazo por escrito e alguém que responde quando precisar mudar um preço.' },
];

const { total, preenchidas, prazo } = site.fundadores;
const appTelas = [
  { src: appAoVivo, alt: 'App da Nova FM: tela do ao vivo' },
  { src: appProgramacao, alt: 'App da Nova FM: programação' },
  { src: appNoticias, alt: 'App da Nova FM: notícias' },
  { src: appPremios, alt: 'App da Nova FM: prêmios' },
];
---

<Layout title={`Sites para negócios de ${site.cidade} | Agiliza Labs`} description="Mockup v3 do site da Agiliza Labs." escuro menu={menu}>
  <!-- O letreiro -->
  <section id="tipos" class="escuro bg-tinta text-papel">
    <div class="conteudo pb-10 pt-14 sm:pt-20">
      <p class="max-w-3xl text-[2.4rem] font-medium leading-[1.02] sm:text-6xl lg:text-7xl">
        Sites que trazem cliente para negócios de {site.cidade}.
      </p>
      <p class="mt-6 max-w-xl text-lg text-nevoa-escura">
        Escolha o seu tipo de site. O preço está na tela, todo site sai com SEO profissional, e você vê o layout pronto antes de pagar o restante.
      </p>
    </div>

    <div class="conteudo pb-16 sm:pb-24">
      <ul class="border-t border-white/15">
        {tiers.map((t) => (
          <li class="border-b border-white/15">
            <details class="tier group" id={t.id}>
              <summary class="grid cursor-pointer list-none grid-cols-[1fr_auto] items-end gap-x-6 gap-y-1 py-6 sm:py-8 [&::-webkit-details-marker]:hidden">
                <span class="nome text-[2.3rem] font-bold leading-none tracking-tight sm:text-7xl lg:text-8xl">{t.nome}</span>
                <span class="text-right">
                  <span class="block text-sm text-nevoa-escura">{t.formas.some((f) => f.aPartirDe || f.setupAte) ? 'a partir de' : 'pago uma vez'}</span>
                  <span class="block whitespace-nowrap text-2xl font-bold text-lima sm:text-4xl">{precoDeVitrine(t)}</span>
                </span>
                <span class="col-span-2 flex items-center justify-between gap-4 text-nevoa-escura sm:text-lg">
                  {t.para}
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/25 transition-transform group-open:rotate-45 motion-reduce:transition-none" aria-hidden="true">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                  </span>
                </span>
              </summary>

              <div class="grid gap-8 pb-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
                <div>
                  <p class="text-nevoa-escura">{t.exemplos}.</p>
                  <ul class="mt-5 space-y-3 text-lg">
                    {t.entra.map((e) => (
                      <li class="flex gap-3">
                        <svg class="mt-1.5 h-4 w-4 shrink-0 text-lima" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 12.5 5 5L20 6.5" /></svg>
                        {e}
                      </li>
                    ))}
                  </ul>
                  {t.opcionais && <p class="mt-5 text-nevoa-escura">Opcional: {t.opcionais.join('; ')}.</p>}
                  <p class="mt-5 font-medium text-lima">{t.prazo}</p>
                </div>
                <div class="space-y-3">
                  {t.formas.map((f) => (
                    <div class="rounded-2xl border border-white/20 p-5">
                      <p class="text-sm text-nevoa-escura">{f.nome}</p>
                      <p class="mt-1 text-2xl font-bold">{precoDaForma(f)}</p>
                      <p class="mt-1 text-sm text-nevoa-escura">{f.nota}</p>
                      {f.mensal && t.noCuidado && (
                        <ul class="mt-3 space-y-1 text-sm">
                          {t.noCuidado.map((c) => <li>+ {c}</li>)}
                        </ul>
                      )}
                    </div>
                  ))}
                  <a href={linkWhatsApp(`Oi, Carlos! Vi o site e quero conversar sobre o ${t.nome}.`)} class="botao-principal w-full text-lg">Quero o {t.nome}</a>
                </div>
              </div>
            </details>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-nevoa-escura">
        Não sabe qual é o seu? <a href={linkWhatsApp('Oi, Carlos! Não sei qual tipo de site serve para o meu negócio.')} class="text-papel underline decoration-lima decoration-2 underline-offset-4">Me conta o que você faz</a> e eu indico.
      </p>
    </div>
  </section>

  <!-- Projetos: mostruário -->
  <section id="projetos" class="conteudo scroll-mt-20 py-16 lg:py-24">
    <h2 class="text-4xl sm:text-5xl">Já no ar em {site.cidade}</h2>

    <article class="mt-12 grid items-center gap-10 lg:grid-cols-[1.5fr_1fr]">
      <div class="relative">
        <a href="https://novafmsbs.com.br" class="navegador block" aria-label="Abrir o site da Nova FM">
          <span class="barra" aria-hidden="true"><i></i><i></i><i></i><b>novafmsbs.com.br</b></span>
          <span class="tela"><Image src={novafmSite} alt="Site da Nova FM 87,5, página inicial completa" width={1100} class="rolar" /></span>
        </a>
        <div class="celular absolute -bottom-8 right-2 w-[28%] sm:right-6" aria-label="Telas do app da Nova FM">
          {appTelas.map((t, i) => <Image src={t.src} alt={t.alt} width={360} class="quadro" style={`animation-delay: ${i * 3}s`} />)}
        </div>
      </div>
      <div>
        <p class="text-sm font-medium text-lima-escura">Site e app Android</p>
        <h3 class="mt-1 text-3xl">Nova FM 87,5</h3>
        <p class="mt-3 text-grafite">Player ao vivo, programação, equipe, promoções com inscrição pelo WhatsApp, página para anunciantes e um app próprio com notícias, prêmios e chat dos ouvintes.</p>
        <a href="https://novafmsbs.com.br" class="mt-4 inline-block underline decoration-lima decoration-2 underline-offset-4">Ver novafmsbs.com.br</a>
      </div>
    </article>

    <article class="mt-24 grid items-center gap-10 lg:grid-cols-[1fr_1.5fr]">
      <div class="lg:order-2">
        <a href="https://portalnovafmsbs.com.br" class="navegador block" aria-label="Abrir o Portal de notícias da Nova FM">
          <span class="barra" aria-hidden="true"><i></i><i></i><i></i><b>portalnovafmsbs.com.br</b></span>
          <span class="tela"><Image src={portalSite} alt="Portal de notícias da Nova FM, página inicial completa" width={1100} class="rolar" /></span>
        </a>
      </div>
      <div class="lg:order-1">
        <p class="text-sm font-medium text-lima-escura">Conteúdo e News</p>
        <h3 class="mt-1 text-3xl">Portal de notícias da Nova FM</h3>
        <p class="mt-3 text-grafite">Notícias de {site.cidade} e região com editorias, busca, o player da rádio integrado, espaços para anunciantes e um canal para a comunidade mandar perguntas.</p>
        <a href="https://portalnovafmsbs.com.br" class="mt-4 inline-block underline decoration-lima decoration-2 underline-offset-4">Ver portalnovafmsbs.com.br</a>
      </div>
    </article>

    <article class="mt-24">
      <div class="max-w-2xl">
        <p class="text-sm font-medium text-lima-escura">Automação com IA</p>
        <h3 class="mt-1 text-3xl">Robô de notícias do Jornal Liberdade</h3>
        <p class="mt-3 text-grafite">De hora em hora, das 8h às 17h, ele lê os sites das prefeituras, câmaras e órgãos do estado no Planalto Norte, escreve a matéria e manda para a redação aprovar.</p>
      </div>
      <ol class="robo mt-8 grid gap-4 md:grid-cols-4" aria-label="Como uma notícia passa pelo robô (exemplo ilustrativo)">
        {robo.map((r, i) => (
          <li class="etapa rounded-2xl border-2 border-tinta bg-white p-5" style={`animation-delay: ${i * 0.9}s`}>
            <p class="flex items-center gap-2 font-semibold"><span class="flex h-7 w-7 items-center justify-center rounded-full bg-tinta text-sm text-lima">{i + 1}</span>{r.etapa}</p>
            <p class="mt-2 text-sm text-grafite">{r.texto}</p>
          </li>
        ))}
      </ol>
      <p class="mt-3 text-sm text-grafite">Exemplo ilustrativo de uma notícia passando pelo robô.</p>
    </article>
  </section>

  <!-- Como fica pronto -->
  <section id="como-funciona" class="scroll-mt-20 border-y border-nevoa bg-white/60">
    <div class="conteudo py-16 lg:py-24">
      <h2 class="max-w-3xl text-4xl sm:text-5xl">Você só paga o restante quando aprovar</h2>
      <p class="mt-4 max-w-2xl text-lg text-grafite">Talvez você esteja pensando que é mais um site que ninguém vai abrir. Por isso você vê tudo pronto antes, e o site sai configurado para ser achado.</p>
      <div class="mt-12 grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
        <ol class="space-y-8">
          {passos.map((p, i) => (
            <li class="flex gap-5">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-tinta font-bold text-lima">{i + 1}</span>
              <div><h3 class="text-xl">{p.titulo}</h3><p class="mt-1 text-grafite">{p.texto}</p></div>
            </li>
          ))}
        </ol>
        <figure aria-label="Exemplo da barra de aprovação que aparece no layout">
          <div class="overflow-hidden rounded-3xl border border-tinta/15 bg-white">
            <div class="space-y-3 p-6" aria-hidden="true">
              <div class="h-5 w-2/3 rounded bg-nevoa"></div>
              <div class="h-24 rounded-xl bg-nevoa"></div>
              <div class="h-4 w-1/2 rounded bg-nevoa"></div>
            </div>
            <div class="escuro flex flex-col gap-3 bg-tinta p-4 text-papel sm:flex-row sm:items-center sm:justify-between">
              <p class="text-sm">Gostou do seu site?</p>
              <div class="flex gap-2">
                <span class="rounded-full border border-white/25 px-4 py-2 text-sm">Pedir correção (1)</span>
                <span class="rounded-full bg-lima px-4 py-2 text-sm font-medium text-tinta">Aprovar layout</span>
              </div>
            </div>
          </div>
          <figcaption class="mt-3 text-center text-sm text-grafite">A barra que aparece no seu layout.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- SEO profissional -->
  <section class="conteudo grid items-center gap-12 py-16 lg:grid-cols-[1fr_1fr] lg:gap-16 lg:py-24">
    <div>
      <h2 class="text-4xl sm:text-5xl">SEO profissional em todo site</h2>
      <p class="mt-4 text-lg text-grafite">Quando alguém pesquisa "manicure perto de mim" ou pergunta para uma IA qual pet shop tem no bairro, o Google e a IA mostram os negócios que conseguem entender. Em todos os tipos de site eu faço este trabalho:</p>
      <ul class="mt-6 space-y-3">
        {seo.map((v) => (
          <li class="flex gap-3">
            <svg class="mt-1 h-4 w-4 shrink-0 text-lima-escura" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 12.5 5 5L20 6.5" /></svg>
            {v}
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-grafite">A posição no Google ninguém controla, então não prometo primeiro lugar.</p>
    </div>
    <figure class="mx-auto w-full max-w-md" aria-label="Exemplo: busca por manicure perto de mim com o negócio aparecendo em primeiro">
      <div class="rounded-[1.75rem] border border-tinta/10 bg-white p-4 shadow-[0_30px_60px_-30px_rgba(14,17,22,.35)] sm:p-5">
        <div class="flex items-center gap-3 rounded-full border border-tinta/15 px-4 py-3">
          <svg class="h-4 w-4 text-grafite" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <span>manicure perto de mim</span>
        </div>
        <div class="mt-4 rounded-2xl border-2 border-lima bg-lima/10 p-4">
          <p class="text-lg font-semibold">Studio da Ana, manicure</p>
          <p class="text-sm text-grafite">4,9 ★★★★★ (87) no Centro de {site.cidade}</p>
          <p class="mt-1 text-sm text-lima-escura">Aberto até as 19h</p>
          <div class="mt-3 flex gap-2 text-sm font-medium">
            <span class="rounded-full bg-tinta px-3 py-1.5 text-papel">WhatsApp</span>
            <span class="rounded-full border border-tinta/20 px-3 py-1.5">Site</span>
            <span class="rounded-full border border-tinta/20 px-3 py-1.5">Rotas</span>
          </div>
        </div>
        <div class="mt-3 space-y-2 opacity-50" aria-hidden="true">
          <div class="h-14 rounded-2xl bg-nevoa"></div>
          <div class="h-14 rounded-2xl bg-nevoa"></div>
        </div>
      </div>
      <figcaption class="mt-3 text-center text-sm text-grafite">Exemplo ilustrativo.</figcaption>
    </figure>
  </section>

  <!-- Quem faz -->
  <section class="border-y border-nevoa bg-white/60">
    <div class="conteudo grid items-center gap-10 py-16 md:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:py-24">
      <div class="flex aspect-[4/5] items-center justify-center rounded-3xl border-2 border-dashed border-tinta/20 bg-nevoa p-6 text-center text-grafite">
        Espaço para a sua foto profissional
      </div>
      <div>
        <h2 class="text-4xl sm:text-5xl">Quem faz o seu site</h2>
        <p class="mt-5 text-lg">Eu sou o Carlos, de {site.cidade}.</p>
        <p class="mt-3 text-lg text-grafite">[Sua história entra aqui, escrita junto com você.]</p>
        <p class="mt-3 text-lg text-grafite">Quem conversa com você é quem constrói o seu site, do começo ao fim.</p>
        <a href={linkWhatsApp('Oi, Carlos! Vi o seu site e quero conversar sobre o meu negócio.')} class="botao-secundario mt-8 text-lg">Falar com o Carlos</a>
      </div>
    </div>
  </section>

  <!-- Dúvidas -->
  <section id="duvidas" class="conteudo grid scroll-mt-20 gap-10 py-16 lg:grid-cols-[1fr_2fr] lg:py-24">
    <h2 class="text-4xl sm:text-5xl">O que costumam perguntar</h2>
    <div class="divide-y divide-tinta/10 border-y border-tinta/10">
      {duvidas.map((d) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-medium [&::-webkit-details-marker]:hidden">
            {d.p}
            <svg class="mt-1 h-5 w-5 shrink-0 transition-transform group-open:rotate-45 motion-reduce:transition-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          </summary>
          <p class="mt-3 max-w-2xl text-grafite">{d.r}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Fechamento -->
  <section class="escuro bg-tinta text-papel">
    <div class="conteudo py-20 lg:py-24">
      <h2 class="max-w-4xl text-5xl leading-[1.02] sm:text-6xl">Seria loucura ver como ficaria o seu?</h2>
      <p class="mt-6 max-w-xl text-lg text-nevoa-escura">Me manda o nome do seu negócio. Em 15 minutos de conversa você sai sabendo o que fazer, mesmo que não feche nada.</p>
      <a href={linkWhatsApp('Oi, Carlos! Quero ver como ficaria o site do meu negócio.')} class="botao-principal mt-9 text-lg">Quero ver o meu</a>
      <p class="mt-8 max-w-xl text-nevoa-escura">
        Programa Fundadores: {fundadores.descontoSetup * 100}% de desconto no setup e {fundadores.mesesDeCuidadoGratis} meses de Cuidado grátis. {total - preenchidas} de {total} vagas, até {prazo}.
      </p>
    </div>
  </section>
</Layout>

<style>
  .tier .nome { transition: color 0.2s; }
  .tier[open] .nome,
  .tier summary:hover .nome { color: var(--color-lima); }
  .tier summary:focus-visible { outline: 3px solid var(--color-lima); outline-offset: 4px; border-radius: 0.5rem; }

  /* Mostruário: navegador que rola a página sozinho e celular que troca de tela. */
  .navegador { overflow: hidden; border-radius: 1.25rem; border: 1px solid color-mix(in srgb, var(--color-tinta) 15%, transparent); background: #fff; box-shadow: 0 40px 80px -40px rgb(14 17 22 / 0.45); }
  .barra { display: flex; align-items: center; gap: 0.4rem; padding: 0.7rem 1rem; border-bottom: 1px solid var(--color-nevoa); }
  .barra i { width: 0.65rem; height: 0.65rem; border-radius: 999px; background: var(--color-nevoa); }
  .barra b { margin-left: 0.75rem; font-size: 0.8rem; font-weight: 500; color: var(--color-grafite); }
  .tela { display: block; aspect-ratio: 16 / 10; }
  .rolar { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; animation: rolar 22s ease-in-out infinite alternate; }
  .navegador:hover .rolar { animation-play-state: paused; }
  @keyframes rolar { 0%, 8% { object-position: 50% 0%; } 92%, 100% { object-position: 50% 100%; } }

  .celular { aspect-ratio: 1080 / 2400; border: 6px solid var(--color-tinta); border-radius: 1.6rem; overflow: hidden; background: var(--color-tinta); box-shadow: 0 30px 60px -25px rgb(14 17 22 / 0.6); }
  .quadro { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; animation: trocar 12s infinite; }
  @keyframes trocar { 0% { opacity: 0; } 4%, 25% { opacity: 1; } 29%, 100% { opacity: 0; } }

  .etapa { animation: acender 3.6s infinite; }
  @keyframes acender { 0%, 30%, 100% { background: #fff; } 8%, 22% { background: color-mix(in srgb, var(--color-lima) 40%, #fff); } }

  @media (prefers-reduced-motion: reduce) {
    .tier .nome, .rolar, .quadro, .etapa { animation: none; transition: none; }
    .quadro:first-child { opacity: 1; }
  }
</style>

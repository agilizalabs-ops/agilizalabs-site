---
// MOCKUP v2 (branch mockup-fluxo). Não publicar: preços ainda são proposta.
// Conceito "letreiro": os 4 Tiers aparecem na abertura, em letra grande e com preço,
// como o quadro de preços de uma loja da rua. O resto da página só responde "como" e "por que confiar".
import Layout from '../layouts/Layout.astro';
import { site, linkWhatsApp, projetos } from '../config';

const brl = (v: number) => `R$ ${v.toLocaleString('pt-BR')}`;

const tiers = [
  {
    id: 'presenca',
    nome: 'Presença',
    para: 'Para quem trabalha sozinho',
    exemplos: 'Manicure, personal, fotógrafo, diarista, professor particular',
    aPartir: brl(500),
    prazo: 'No ar em 7 dias úteis',
    entra: ['Site de 1 página com seus serviços, preços e fotos', 'Google Perfil criado ou ajustado', 'Botão de WhatsApp com mensagem pronta', 'Respostas rápidas do WhatsApp e um QR code para o balcão'],
    formas: [
      { nome: 'Pago uma vez', valor: brl(1000), nota: `${brl(300)} para começar, ${brl(700)} quando aprovar o layout` },
      { nome: 'Com Cuidado', valor: `${brl(500)} + ${brl(59)}/mês`, nota: 'Site sempre no ar e 1 alteração por mês' },
    ],
  },
  {
    id: 'institucional',
    nome: 'Institucional',
    para: 'Para empresa com endereço e equipe',
    exemplos: 'Oficina, clínica, loja de bairro, restaurante, prestador de serviço',
    aPartir: brl(1400),
    prazo: 'No ar em 15 dias úteis',
    entra: ['Até 5 páginas: início, serviços, sobre, contato e mais uma', 'Formulário de orçamento, WhatsApp e mapa', 'Uma página por serviço com o nome da cidade, para a busca local', 'Textos revisados com você'],
    formas: [
      { nome: 'Pago uma vez', valor: brl(2400), nota: '30% para começar, 70% quando aprovar o layout' },
      { nome: 'Com Cuidado', valor: `${brl(1400)} + ${brl(149)}/mês`, nota: 'Site sempre no ar e 3 alterações por mês' },
    ],
  },
  {
    id: 'conteudo',
    nome: 'Conteúdo e News',
    para: 'Para quem publica toda semana',
    exemplos: 'Portal de notícias, rádio, blog, associação',
    aPartir: brl(3500),
    prazo: 'Prazo combinado na proposta',
    entra: ['Painel para a sua equipe publicar sem depender de ninguém', 'Editorias, busca e notícias relacionadas', 'Espaços para anunciantes', 'Cada matéria pronta para aparecer no Google'],
    formas: [{ nome: 'Projeto', valor: `a partir de ${brl(3500)}`, nota: 'Valor fechado depois de uma conversa sobre a sua redação' }],
  },
  {
    id: 'loja',
    nome: 'E‑commerce',
    para: 'Para quem vende produto',
    exemplos: 'Loja de roupa, artesanato, alimentos, peças',
    aPartir: brl(2500),
    prazo: 'No ar em 15 dias úteis',
    entra: ['Loja na Nuvemshop, Shopify ou Loja Integrada, com Pix e cartão', 'Visual com a sua marca e até 30 produtos cadastrados', 'Frete, domínio e Google configurados', '1 hora de treinamento para você cadastrar sozinho'],
    formas: [{ nome: 'Projeto + Cuidado', valor: `${brl(2500)} a ${brl(4000)} + ${brl(197)}/mês`, nota: 'Conforme o número de produtos. A plataforma você paga direto' }],
  },
];

const passos = [
  { titulo: 'Conversa de 15 minutos', texto: 'Pessoalmente ou no WhatsApp. Eu anoto o que você faz, quem é o seu cliente e o que te preocupa.' },
  { titulo: 'Entrada de 30% e prazo por escrito', texto: 'Pelo Pix. A produção começa no mesmo dia.' },
  { titulo: 'Você aprova no próprio layout', texto: 'O layout chega num link com dois botões: aprovar ou pedir uma correção.' },
  { titulo: 'Paga o restante e vai ao ar', texto: 'Pix ou cartão, ali mesmo. O site entra no ar em até 1 dia útil.' },
];

const visibilidade = [
  'Google Perfil completo, que é o que mais pesa no "perto de mim"',
  'Nome, endereço e telefone iguais no site, no Google e nas redes',
  'Dados que o Google e as IAs leem para saber o que você faz e onde',
  'Perguntas frequentes escritas do jeito que as pessoas pesquisam',
  'Cadastro no Google e no Bing, que alimenta a busca do ChatGPT',
  'Nota mínima de 90 no teste de velocidade do Google, no celular',
];

const duvidas = [
  { p: 'E se eu não gostar do layout?', r: 'Você pede uma correção antes de aprovar, e os 70% só são cobrados depois que você clica em "Aprovar layout".' },
  { p: 'Vocês garantem primeiro lugar no Google?', r: 'Não. Ninguém controla a posição, e quem promete está chutando. O que eu garanto é o site e o Google Perfil configurados do jeito que o Google usa para escolher quem mostrar.' },
  { p: 'Preciso pagar mensalidade?', r: 'Só se quiser. Pago uma vez, o site fica na sua conta e cada alteração pequena custa R$ 80. Com Cuidado, você paga menos no começo e eu mantenho tudo no ar.' },
  { p: 'O domínio fica no meu nome?', r: 'Sim, o endereço .com.br é registrado no seu nome. Se um dia quiser sair, leva tudo.' },
  { p: 'Meu sobrinho faz site. Por que eu pagaria você?', r: 'Ele pode fazer um ótimo site. Comigo vêm junto o Google Perfil, a preparação para a busca, o prazo por escrito e alguém que responde quando precisar mudar um preço.' },
];

const { total, preenchidas, prazo } = site.fundadores;
const provas = projetos.filter((p) => p.link && p.status !== 'em desenvolvimento');
---

<Layout title={`Sites para negócios de ${site.cidade} | Agiliza Labs`} description="Mockup v2 do site da Agiliza Labs: os quatro tipos de site com preço.">
  <!-- O letreiro -->
  <section class="escuro letreiro bg-tinta text-papel">
    <div class="conteudo pb-10 pt-14 sm:pt-20">
      <p class="max-w-3xl text-[2.4rem] font-medium leading-[1.02] sm:text-6xl lg:text-7xl">
        Sites que trazem cliente para negócios de {site.cidade}.
      </p>
      <p class="mt-6 max-w-xl text-lg text-nevoa-escura">
        Escolha o seu tipo de site abaixo. O preço está na tela, e você vê o layout pronto antes de pagar o restante.
      </p>
    </div>

    <div class="conteudo pb-16 sm:pb-24">
      <ul class="border-t border-white/15">
        {tiers.map((t) => (
          <li class="border-b border-white/15">
            <details class="tier group" id={t.id}>
              <summary class="grid cursor-pointer list-none grid-cols-[1fr_auto] items-end gap-x-6 gap-y-1 py-6 sm:py-8 [&::-webkit-details-marker]:hidden">
                <span class="nome text-[2.3rem] font-bold leading-none tracking-tight sm:text-7xl lg:text-8xl">{t.nome}</span>
                <span class="text-right">
                  <span class="block text-sm text-nevoa-escura">a partir de</span>
                  <span class="block whitespace-nowrap text-2xl font-bold text-lima sm:text-4xl">{t.aPartir}</span>
                </span>
                <span class="col-span-2 flex items-center justify-between gap-4 text-nevoa-escura sm:text-lg">
                  {t.para}
                  <span class="abrir flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/25 transition-transform group-open:rotate-45 motion-reduce:transition-none" aria-hidden="true">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                  </span>
                </span>
              </summary>

              <div class="grid gap-8 pb-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
                <div>
                  <p class="text-nevoa-escura">{t.exemplos}.</p>
                  <ul class="mt-5 space-y-3 text-lg">
                    {t.entra.map((e) => (
                      <li class="flex gap-3">
                        <svg class="mt-1.5 h-4 w-4 shrink-0 text-lima" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 12.5 5 5L20 6.5" /></svg>
                        {e}
                      </li>
                    ))}
                  </ul>
                  <p class="mt-5 font-medium text-lima">{t.prazo}</p>
                </div>
                <div class="space-y-3">
                  {t.formas.map((f) => (
                    <div class="rounded-2xl border border-white/20 p-5">
                      <p class="text-sm text-nevoa-escura">{f.nome}</p>
                      <p class="mt-1 text-2xl font-bold">{f.valor}</p>
                      <p class="mt-1 text-sm text-nevoa-escura">{f.nota}</p>
                    </div>
                  ))}
                  <a href={linkWhatsApp(`Oi, Carlos! Vi o site e quero conversar sobre o ${t.nome}.`)} class="botao-principal w-full text-lg">Quero o {t.nome}</a>
                </div>
              </div>
            </details>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-nevoa-escura">
        Não sabe qual é o seu? <a href={linkWhatsApp('Oi, Carlos! Não sei qual tipo de site serve para o meu negócio.')} class="text-papel underline decoration-lima decoration-2 underline-offset-4">Me conta o que você faz</a> e eu indico.
      </p>
    </div>
  </section>

  <!-- Como fica pronto -->
  <section id="como-funciona" class="conteudo py-16 lg:py-24">
    <h2 class="max-w-3xl text-4xl sm:text-5xl">Você só paga o restante quando aprovar</h2>
    <p class="mt-4 max-w-2xl text-lg text-grafite">Talvez você esteja pensando que é mais um site que ninguém vai abrir. Por isso você vê tudo pronto antes, e o site sai configurado para ser achado.</p>
    <div class="mt-12 grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
      <ol class="space-y-8">
        {passos.map((p, i) => (
          <li class="flex gap-5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-tinta font-bold text-lima">{i + 1}</span>
            <div><h3 class="text-xl">{p.titulo}</h3><p class="mt-1 text-grafite">{p.texto}</p></div>
          </li>
        ))}
      </ol>
      <figure aria-label="Exemplo da barra de aprovação que aparece no layout">
        <div class="overflow-hidden rounded-3xl border border-tinta/15 bg-white">
          <div class="space-y-3 p-6" aria-hidden="true">
            <div class="h-5 w-2/3 rounded bg-nevoa"></div>
            <div class="h-24 rounded-xl bg-nevoa"></div>
            <div class="h-4 w-1/2 rounded bg-nevoa"></div>
          </div>
          <div class="escuro flex flex-col gap-3 bg-tinta p-4 text-papel sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm">Gostou do seu site?</p>
            <div class="flex gap-2">
              <span class="rounded-full border border-white/25 px-4 py-2 text-sm">Pedir correção (1)</span>
              <span class="rounded-full bg-lima px-4 py-2 text-sm font-medium text-tinta">Aprovar layout</span>
            </div>
          </div>
        </div>
        <figcaption class="mt-3 text-center text-sm text-grafite">A barra que aparece no seu layout.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Achado no Google -->
  <section class="border-y border-nevoa bg-white/60">
    <div class="conteudo grid items-center gap-12 py-16 lg:grid-cols-[1fr_1fr] lg:gap-16 lg:py-24">
      <div>
        <h2 class="text-4xl sm:text-5xl">Todo site sai pronto para ser achado</h2>
        <p class="mt-4 text-lg text-grafite">Quando alguém pesquisa "manicure perto de mim" ou pergunta para uma IA qual pet shop tem no bairro, o Google e a IA escolhem entre os negócios que entendem. Em todos os tipos de site, eu faço este trabalho:</p>
        <ul class="mt-6 space-y-3">
          {visibilidade.map((v) => (
            <li class="flex gap-3">
              <svg class="mt-1 h-4 w-4 shrink-0 text-lima-escura" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 12.5 5 5L20 6.5" /></svg>
              {v}
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-grafite">A posição no Google ninguém controla, então não prometo primeiro lugar.</p>
      </div>
      <figure class="mx-auto w-full max-w-md" aria-label="Exemplo: busca por manicure perto de mim com o negócio aparecendo em primeiro">
        <div class="rounded-[1.75rem] border border-tinta/10 bg-white p-4 shadow-[0_30px_60px_-30px_rgba(14,17,22,.35)] sm:p-5">
          <div class="flex items-center gap-3 rounded-full border border-tinta/15 px-4 py-3">
            <svg class="h-4 w-4 text-grafite" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <span>manicure perto de mim</span>
          </div>
          <div class="mt-4 rounded-2xl border-2 border-lima bg-lima/10 p-4">
            <p class="text-lg font-semibold">Studio da Ana, manicure</p>
            <p class="text-sm text-grafite">4,9 ★★★★★ (87) no Centro de {site.cidade}</p>
            <p class="mt-1 text-sm text-lima-escura">Aberto até as 19h</p>
            <div class="mt-3 flex gap-2 text-sm font-medium">
              <span class="rounded-full bg-tinta px-3 py-1.5 text-papel">WhatsApp</span>
              <span class="rounded-full border border-tinta/20 px-3 py-1.5">Site</span>
              <span class="rounded-full border border-tinta/20 px-3 py-1.5">Rotas</span>
            </div>
          </div>
          <div class="mt-3 space-y-2 opacity-50" aria-hidden="true">
            <div class="h-14 rounded-2xl bg-nevoa"></div>
            <div class="h-14 rounded-2xl bg-nevoa"></div>
          </div>
        </div>
        <figcaption class="mt-3 text-center text-sm text-grafite">Exemplo ilustrativo.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Já no ar -->
  <section id="projetos" class="conteudo py-16 lg:py-24">
    <h2 class="text-4xl sm:text-5xl">Já no ar em {site.cidade}</h2>
    <div class="mt-10 grid gap-x-10 gap-y-10 md:grid-cols-2">
      {provas.map((p) => (
        <a href={p.link} class="group block border-t-2 border-tinta pt-5">
          <p class="text-sm font-medium text-lima-escura">{p.tipo}</p>
          <h3 class="mt-1 text-3xl group-hover:underline group-hover:decoration-lima group-hover:decoration-4 group-hover:underline-offset-4">{p.nome}</h3>
          <p class="mt-2 text-grafite">{p.resumo}</p>
          <p class="mt-3 text-sm font-medium">{p.link?.replace('https://', '')}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Quem faz -->
  <section class="border-y border-nevoa bg-white/60">
    <div class="conteudo grid items-center gap-10 py-16 md:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:py-24">
      <div class="flex aspect-[4/5] items-center justify-center rounded-3xl border-2 border-dashed border-tinta/20 bg-nevoa p-6 text-center text-grafite">
        Espaço para a sua foto profissional
      </div>
      <div>
        <h2 class="text-4xl sm:text-5xl">Quem faz o seu site</h2>
        <p class="mt-5 text-lg">Eu sou o Carlos, de {site.cidade}.</p>
        <p class="mt-3 text-lg text-grafite">[Sua história entra aqui, escrita junto com você.]</p>
        <p class="mt-3 text-lg text-grafite">Quem conversa com você é quem constrói o seu site, do começo ao fim.</p>
        <a href={linkWhatsApp('Oi, Carlos! Vi o seu site e quero conversar sobre o meu negócio.')} class="botao-secundario mt-8 text-lg">Falar com o Carlos</a>
      </div>
    </div>
  </section>

  <!-- Dúvidas -->
  <section id="duvidas" class="conteudo grid gap-10 py-16 lg:grid-cols-[1fr_2fr] lg:py-24">
    <h2 class="text-4xl sm:text-5xl">O que costumam perguntar</h2>
    <div class="divide-y divide-tinta/10 border-y border-tinta/10">
      {duvidas.map((d) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-medium [&::-webkit-details-marker]:hidden">
            {d.p}
            <svg class="mt-1 h-5 w-5 shrink-0 transition-transform group-open:rotate-45 motion-reduce:transition-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          </summary>
          <p class="mt-3 max-w-2xl text-grafite">{d.r}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Fechamento -->
  <section class="escuro bg-tinta text-papel">
    <div class="conteudo py-20 lg:py-24">
      <h2 class="max-w-4xl text-5xl leading-[1.02] sm:text-6xl">Seria loucura ver como ficaria o seu?</h2>
      <p class="mt-6 max-w-xl text-lg text-nevoa-escura">Me manda o nome do seu negócio. Em 15 minutos de conversa você sai sabendo o que fazer, mesmo que não feche nada.</p>
      <a href={linkWhatsApp('Oi, Carlos! Quero ver como ficaria o site do meu negócio.')} class="botao-principal mt-9 text-lg">Quero ver o meu</a>
      <p class="mt-8 text-sm text-nevoa-escura">Programa Fundadores: {total - preenchidas} de {total} vagas, até {prazo}.</p>
    </div>
  </section>
</Layout>

<style>
  /* O único gesto forte da página: o letreiro reage ao dedo e ao mouse, mostrando qual tipo está aberto. */
  .tier .nome {
    transition: color 0.2s;
  }
  .tier[open] .nome,
  .tier summary:hover .nome {
    color: var(--color-lima);
  }
  .tier summary:focus-visible {
    outline: 3px solid var(--color-lima);
    outline-offset: 4px;
    border-radius: 0.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .tier .nome { transition: none; }
  }
</style>

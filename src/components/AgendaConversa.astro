---
// Agenda da conversa sobre o plano. Abre a partir de qualquer elemento com [data-abrir-agenda]
// (o montador do plano e o chat). Se a agenda não carregar, o link original (WhatsApp) segue valendo.
import { textoAceite } from '../data/conteudo';
---

<agenda-conversa>
  <dialog data-dialogo class="m-auto w-[min(100%-2rem,34rem)] rounded-3xl bg-papel p-0 text-tinta shadow-2xl backdrop:bg-tinta/60" aria-labelledby="agenda-titulo">
    <div class="flex max-h-[90dvh] flex-col">
      <header class="escuro flex items-start justify-between gap-3 bg-tinta px-6 py-5 text-papel">
        <div>
          <h2 id="agenda-titulo" class="text-xl font-semibold">Agendar conversa sobre o plano</h2>
          <p data-plano class="mt-1 text-sm text-nevoa-escura"></p>
        </div>
        <button type="button" data-fechar class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/25" aria-label="Fechar">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </header>

      <div class="overflow-y-auto px-6 py-5">
        <p data-carregando class="text-grafite">Buscando os horários livres…</p>
        <div data-falhou hidden class="space-y-3">
          <p data-falhou-texto class="text-grafite"></p>
          <a data-whatsapp class="botao-principal" href="#" target="_blank" rel="noopener">Combinar pelo WhatsApp</a>
        </div>

        <form data-form hidden class="space-y-5" novalidate>
          <fieldset>
            <legend class="font-medium">Próximos horários livres</legend>
            <div data-proximos class="mt-3 grid gap-2 sm:grid-cols-3"></div>
            <button type="button" data-outros class="mt-3 text-sm underline decoration-lima decoration-2 underline-offset-4">Ver outros dias</button>
            <div data-calendario hidden class="mt-4">
              <div data-dias class="flex gap-2 overflow-x-auto pb-2"></div>
              <div data-horas class="mt-2 grid grid-cols-4 gap-2"></div>
            </div>
          </fieldset>

          <fieldset>
            <legend class="font-medium">Como prefere conversar?</legend>
            <div data-formatos class="mt-3 grid gap-2"></div>
          </fieldset>

          <fieldset class="space-y-2">
            <legend class="mb-3 font-medium">Seus dados</legend>
            <input name="nome" autocomplete="name" required placeholder="Seu nome" class="campo-agenda" />
            <input name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" required placeholder="WhatsApp com DDD" class="campo-agenda" />
            <input name="email" type="email" inputmode="email" autocomplete="email" required placeholder="E-mail" class="campo-agenda" />
            <input name="tipoNegocio" autocomplete="organization-title" required placeholder="Seu negócio (ex.: manicure, oficina)" class="campo-agenda" />
            <label class="flex items-start gap-2 pt-1 text-sm text-grafite">
              <input name="aceite" type="checkbox" class="mt-1 h-4 w-4 shrink-0 accent-tinta" />
              <span>{textoAceite} <a href="/privacidade" class="underline" target="_blank">Política de privacidade</a>.</span>
            </label>
          </fieldset>

          <p data-erro class="text-sm text-red-700" role="alert"></p>
          <button type="submit" data-confirmar class="botao-principal w-full text-lg disabled:opacity-60" disabled>Escolha um horário</button>
        </form>

        <div data-pronto hidden class="space-y-4" aria-live="polite">
          <p class="text-2xl font-semibold">Conversa marcada ✓</p>
          <p data-pronto-texto class="text-lg"></p>
          <p class="text-grafite">O Carlos te chama no WhatsApp para confirmar.</p>
          <div class="flex flex-col gap-2 sm:flex-row">
            <a data-google class="botao-principal" target="_blank" rel="noopener" href="#">Adicionar à minha agenda</a>
            <a data-ics class="botao-secundario" download="conversa-agiliza.ics" href="#">Baixar para o celular</a>
          </div>
        </div>
      </div>
    </div>
  </dialog>
</agenda-conversa>

<style>
  .campo-agenda { width: 100%; border: 1px solid color-mix(in srgb, var(--color-tinta) 20%, transparent); border-radius: 0.9rem; padding: 0.65rem 0.85rem; background: #fff; }
  .vaga { border: 2px solid color-mix(in srgb, var(--color-tinta) 15%, transparent); border-radius: 0.9rem; padding: 0.55rem 0.6rem; background: #fff; text-align: center; font-size: 0.95rem; }
  .vaga:hover { border-color: var(--color-tinta); }
  .vaga[aria-pressed='true'] { border-color: var(--color-tinta); background: var(--color-lima); font-weight: 600; }
  .dia { flex-shrink: 0; border: 1px solid color-mix(in srgb, var(--color-tinta) 20%, transparent); border-radius: 999px; padding: 0.35rem 0.85rem; font-size: 0.9rem; background: #fff; white-space: nowrap; }
  .dia[aria-pressed='true'] { background: var(--color-tinta); color: var(--color-papel); }
  .formato { display: flex; align-items: center; gap: 0.6rem; border: 2px solid color-mix(in srgb, var(--color-tinta) 15%, transparent); border-radius: 0.9rem; padding: 0.65rem 0.85rem; background: #fff; cursor: pointer; }
  .formato:has(input:checked) { border-color: var(--color-tinta); background: color-mix(in srgb, var(--color-lima) 35%, #fff); }
</style>

<script>
  type Horario = { inicio: string; hora: string; rotulo?: string };
  type Dia = { data: string; rotulo: string; horarios: Horario[] };

  const $ = <T extends Element>(raiz: ParentNode, s: string) => raiz.querySelector<T>(s)!;
  const botao = (texto: string, classe: string) => Object.assign(document.createElement('button'), { type: 'button', className: classe, textContent: texto });

  function conversaDoChat() {
    try {
      return JSON.parse(sessionStorage.getItem('agiliza-chat') ?? '{}').conversaId as string | undefined;
    } catch {
      return undefined;
    }
  }

  class AgendaConversa extends HTMLElement {
    private dialogo = $<HTMLDialogElement>(this, '[data-dialogo]');
    private form = $<HTMLFormElement>(this, '[data-form]');
    private confirmar = $<HTMLButtonElement>(this, '[data-confirmar]');
    private plano = '';
    private escolhido: Horario | null = null;
    private dias: Dia[] = [];

    connectedCallback() {
      document.addEventListener('click', (e) => {
        const gatilho = (e.target as Element).closest<HTMLElement>('[data-abrir-agenda]');
        if (!gatilho) return;
        e.preventDefault();
        this.abrir(gatilho.dataset.plano ?? '', (gatilho as HTMLAnchorElement).href);
      });
      $(this, '[data-fechar]').addEventListener('click', () => this.dialogo.close());
      $(this, '[data-outros]').addEventListener('click', () => $(this, '[data-calendario]').toggleAttribute('hidden'));
      this.form.addEventListener('submit', (e) => {
        e.preventDefault();
        this.enviar();
      });
    }

    private async abrir(plano: string, linkReserva: string) {
      this.plano = plano;
      $(this, '[data-plano]').textContent = plano ? `Seu plano: ${plano}` : 'Escolha um horário de 30 minutos.';
      $<HTMLAnchorElement>(this, '[data-whatsapp]').href = linkReserva?.startsWith('https://wa.me') ? linkReserva : `https://wa.me/5547984182023`;
      for (const s of ['[data-form]', '[data-falhou]', '[data-pronto]']) $(this, s).setAttribute('hidden', '');
      $(this, '[data-carregando]').removeAttribute('hidden');
      this.dialogo.showModal();
      await this.carregar();
    }

    private async carregar(aviso = '') {
      try {
        const resposta = await fetch('/api/agenda/horarios');
        const dados = await resposta.json();
        if (!resposta.ok) throw new Error(dados.erro);
        this.dias = dados.dias;
        this.montar(dados.proximos, dados.formatos);
        $(this, '[data-erro]').textContent = aviso;
        $(this, '[data-carregando]').setAttribute('hidden', '');
        this.form.removeAttribute('hidden');
      } catch {
        $(this, '[data-carregando]').setAttribute('hidden', '');
        $(this, '[data-falhou-texto]').textContent = 'A agenda on-line não abriu agora. Combine o horário direto com o Carlos:';
        $(this, '[data-falhou]').removeAttribute('hidden');
      }
    }

    private montar(proximos: Horario[], formatos: string[]) {
      this.escolhido = null;
      this.atualizarBotao();
      const lista = $(this, '[data-proximos]');
      lista.replaceChildren(...proximos.map((h) => this.vaga(h, h.rotulo!)));
      if (!proximos.length) lista.textContent = 'Sem horários livres nos próximos dias. Combine pelo WhatsApp.';

      const dias = $(this, '[data-dias]');
      dias.replaceChildren(
        ...this.dias.map((d, i) => {
          const b = botao(d.rotulo, 'dia');
          b.setAttribute('aria-pressed', String(i === 0));
          b.addEventListener('click', () => {
            dias.querySelectorAll('.dia').forEach((x) => x.setAttribute('aria-pressed', 'false'));
            b.setAttribute('aria-pressed', 'true');
            this.horasDoDia(d);
          });
          return b;
        }),
      );
      if (this.dias[0]) this.horasDoDia(this.dias[0]);

      const caixa = $(this, '[data-formatos]');
      caixa.replaceChildren(
        ...formatos.map((f, i) => {
          const rotulo = document.createElement('label');
          rotulo.className = 'formato';
          rotulo.innerHTML = `<input type="radio" name="formato" class="accent-tinta" ${i === 0 ? 'checked' : ''}><span></span>`;
          (rotulo.querySelector('input') as HTMLInputElement).value = f;
          rotulo.querySelector('span')!.textContent = f;
          return rotulo;
        }),
      );
    }

    private horasDoDia(d: Dia) {
      $(this, '[data-horas]').replaceChildren(...d.horarios.map((h) => this.vaga({ ...h, rotulo: `${d.rotulo}, ${h.hora}` }, h.hora)));
    }

    private vaga(h: Horario, texto: string) {
      const b = botao(texto, 'vaga');
      b.dataset.inicio = h.inicio;
      b.setAttribute('aria-pressed', String(this.escolhido?.inicio === h.inicio));
      b.addEventListener('click', () => {
        this.escolhido = h;
        this.querySelectorAll('.vaga').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.inicio === h.inicio)));
        this.atualizarBotao();
      });
      return b;
    }

    private atualizarBotao() {
      this.confirmar.disabled = !this.escolhido;
      this.confirmar.textContent = this.escolhido ? `Confirmar ${this.escolhido.rotulo}` : 'Escolha um horário';
    }

    private async enviar() {
      if (!this.escolhido) return;
      const dados = Object.fromEntries(new FormData(this.form));
      const erro = $(this, '[data-erro]');
      erro.textContent = '';
      this.confirmar.disabled = true;
      const resposta = await fetch('/api/agenda/agendar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...dados, aceite: dados.aceite === 'on', inicio: this.escolhido.inicio, plano: this.plano, conversaId: conversaDoChat() }),
      }).catch(() => null);
      const corpo = resposta ? await resposta.json().catch(() => ({})) : {};
      if (!resposta?.ok) {
        if (corpo.ocupado) return this.carregar(corpo.erro);
        erro.textContent = corpo.erro ?? 'Não deu para marcar agora. Tente de novo.';
        this.confirmar.disabled = false;
        return;
      }
      this.concluir(corpo);
    }

    private concluir(r: { inicio: string; fim: string; quando: string; formato: string }) {
      const compacto = (iso: string) => iso.replace(/[-:]/g, '').replace(/\.\d{3}/, '');
      const titulo = 'Conversa com o Carlos (Agiliza Labs)';
      const detalhes = `${r.formato}. ${this.plano ? `Plano: ${this.plano}.` : ''} WhatsApp do Carlos: +55 47 98418-2023`;
      $<HTMLAnchorElement>(this, '[data-google]').href =
        `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(titulo)}&dates=${compacto(r.inicio)}/${compacto(r.fim)}&details=${encodeURIComponent(detalhes)}`;
      const ics = [
        'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Agiliza Labs//Agenda//PT', 'BEGIN:VEVENT',
        `UID:${crypto.randomUUID()}@agilizalabs.com.br`, `DTSTAMP:${compacto(new Date().toISOString())}`,
        `DTSTART:${compacto(r.inicio)}`, `DTEND:${compacto(r.fim)}`, `SUMMARY:${titulo}`, `DESCRIPTION:${detalhes}`,
        'END:VEVENT', 'END:VCALENDAR',
      ].join('\r\n');
      $<HTMLAnchorElement>(this, '[data-ics]').href = `data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}`;
      $(this, '[data-pronto-texto]').textContent = `${r.quando}. ${r.formato}.`;
      this.form.setAttribute('hidden', '');
      $(this, '[data-pronto]').removeAttribute('hidden');
    }
  }

  customElements.define('agenda-conversa', AgendaConversa);
</script>

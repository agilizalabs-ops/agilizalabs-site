---
// O fim da compra do Express (pico e fim): vaga garantida e o caminho direto para montar o site.
// Usado na página de retorno e no painel de pagamento da página /express.
import { express } from '../data/tiers';

interface Props {
  negocio: string;
  /** Link da área de envio. Na /express ele chega pelo navegador depois do pagamento. */
  linkEnvio: string;
}
const { negocio, linkEnvio } = Astro.props;
---

<div class="grid gap-5">
  <ol class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-grafite" aria-label="Etapas da compra">
    <li>✓ Seus dados</li>
    <li>✓ Pagamento</li>
    <li class="font-semibold text-tinta" aria-current="step">3. Monte seu site</li>
  </ol>
  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-lima-escura">Pagamento confirmado ✓</p>
    <h2 class="mt-2 text-3xl sm:text-4xl">Sua vaga está garantida!</h2>
    <p class="mt-3 text-lg text-grafite">Agora monte o site do <span data-negocio>{negocio}</span>: serviços, preços, fotos e horário. Leva uns 5 minutos e salva sozinho.</p>
  </div>
  <a class="botao-principal w-full text-lg" href={linkEnvio} data-link-envio>Montar meu site agora</a>
  <p class="text-sm text-grafite">O site fica pronto em até {express.prazoHorasUteis} horas úteis depois do seu envio. Você vê a prévia antes de publicar e pode pedir 1 ajuste.</p>
</div>

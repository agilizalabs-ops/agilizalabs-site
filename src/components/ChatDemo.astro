---
// Demonstração do atendimento automático: conversa fictícia de uma clínica às 22h47.
const mensagens = [
  { de: 'cliente', texto: 'Oi! Vocês têm horário pra limpeza de pele amanhã?', hora: '22:47' },
  { de: 'negocio', texto: 'Oi, Marina! Tenho amanhã às 10h ou às 15h30. Qual fica melhor pra você?', hora: '22:47' },
  { de: 'cliente', texto: '15h30 😊', hora: '22:48' },
  { de: 'negocio', texto: 'Pronto, agendado! Quinta às 15h30, limpeza de pele. Te mando um lembrete 2 horas antes. Até amanhã!', hora: '22:48' },
];
---

<figure class="mx-auto w-full max-w-[340px] lg:mx-0 lg:ml-auto">
  <div class="relative">
  <div class="rounded-[2.6rem] border-[10px] border-tinta bg-[#E4E6DD] shadow-2xl shadow-tinta/25">
    <div class="flex items-center gap-3 rounded-t-[1.9rem] bg-tinta px-4 pb-3 pt-4 text-papel">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-lima text-sm font-bold text-tinta" aria-hidden="true">BE</span>
      <span class="leading-tight">
        <span class="block text-[0.95rem] font-medium">Clínica Bem Estar</span>
        <span class="block text-xs text-nevoa-escura">online</span>
      </span>
    </div>

    <ol class="space-y-2.5 px-3 pb-36 pt-4 text-[0.9rem] leading-snug" aria-label="Exemplo de conversa">
      {
        mensagens.map((m, i) => (
          <li
            class:list={[
              'surge max-w-[82%] rounded-2xl px-3.5 py-2 shadow-sm',
              m.de === 'cliente' ? 'ml-auto rounded-br-md bg-lima' : 'rounded-bl-md bg-white',
            ]}
            style={`--atraso: ${0.5 + i * 1.1}s`}
          >
            <span class="sr-only">{m.de === 'cliente' ? 'Cliente:' : 'Clínica:'}</span>
            {m.texto}
            <span class="ml-2 inline-block text-[0.7rem] text-grafite">{m.hora}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <div
    class="surge absolute -left-4 bottom-6 w-60 rounded-2xl border border-nevoa bg-papel p-4 shadow-xl shadow-tinta/15 sm:-left-10"
    style="--atraso: 5s"
  >
    <p class="flex items-center gap-2 text-xs font-medium text-lima-escura">
      <span class="h-2 w-2 rounded-full bg-lima ring-2 ring-lima/40" aria-hidden="true"></span>
      Novo na agenda
    </p>
    <p class="mt-1 font-bold">Quinta, 15h30</p>
    <p class="text-sm text-grafite">Limpeza de pele com Marina</p>
  </div>
  </div>

  <figcaption class="mt-8 text-center text-sm text-grafite lg:text-right">
    Exemplo de atendimento automático. A cliente chamou às 22h47 e saiu com horário marcado, sem ninguém da clínica no celular.
  </figcaption>
</figure>

<style>
  .surge {
    animation: surge 0.45s ease-out both;
    animation-delay: var(--atraso);
  }
  @keyframes surge {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .surge {
      animation: none;
    }
  }
</style>
